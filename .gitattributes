# Auto detect text files and normalize to LF on commit
* text=auto eol=lf

# Ensure these are always treated as text with LF line endings
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.sln text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.nuspec text eol=lf
*.scriban text eol=lf
*.editorconfig text eol=lf

# Ensure batch and shell scripts have correct line endings
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files - don't modify
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.nupkg binary
