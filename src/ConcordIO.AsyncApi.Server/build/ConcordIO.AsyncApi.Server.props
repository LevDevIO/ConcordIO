<!--
  ConcordIO.AsyncApi.Server.props
  ===============================
  Default properties for AsyncAPI document generation from .NET message types.
  
  This file is automatically imported when referencing the ConcordIO.AsyncApi.Server package.
  Properties can be overridden in your .csproj file.
  
  CONFIGURATION PROPERTIES:
  ========================
  
  ConcordIOEventTypes (required)
    Semicolon-separated patterns for discovering event message types.
    Patterns: "Namespace.*" (exact) or "Namespace.**" (with sub-namespaces)
    Example: "MyApp.Events.*;MyApp.Domain.Events.**"
    
  ConcordIOCommandTypes (optional)
    Semicolon-separated patterns for discovering command message types.
    Example: "MyApp.Commands.*"
  
  ConcordIOAsyncApiDocumentVersion (default: $(Version) or "1.0.0")
    Version string in the generated AsyncAPI document.
  
  ConcordIOAsyncApiOutputFormat (default: "json")
    Output format: "json" (default, more reliable) or "yaml"
  
  ConcordIOAsyncApiDocumentTitle (default: $(AssemblyName))
    Title in the generated document and output filename.
  
  ConcordIOAsyncApiOutputPath (default: obj/{Config}/{TFM}/asyncapi/)
    Output directory for the generated AsyncAPI file.
  
  ConcordIOIncludeAsyncApiInPackage (default: "true")
    When true, includes the generated spec in NuGet package under asyncapi/.
  
  USAGE EXAMPLE:
  ==============
  <PropertyGroup>
    <ConcordIOEventTypes>MyService.Events.*</ConcordIOEventTypes>
    <ConcordIOCommandTypes>MyService.Commands.*</ConcordIOCommandTypes>
    <ConcordIOAsyncApiDocumentVersion>2.0.0</ConcordIOAsyncApiDocumentVersion>
    <ConcordIOAsyncApiOutputFormat>json</ConcordIOAsyncApiOutputFormat>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="ConcordIO.AsyncApi.Server" Version="0.1.0" />
  </ItemGroup>
  
  TROUBLESHOOTING:
  ================
  - No types discovered: Check pattern matches actual namespaces in assembly
  - Document not generated: Ensure ConcordIOEventTypes or ConcordIOCommandTypes is set
  - Wrong output location: ConcordIOAsyncApiOutputPath is computed at target time
-->
<Project>

  <PropertyGroup>
    <!-- 
      IMPORTANT: Do NOT set defaults for ConcordIOAsyncApiOutputPath or ConcordIOAsyncApiDocumentTitle here.
      These depend on $(IntermediateOutputPath) and $(AssemblyName) which are not available at props evaluation time.
      Defaults are computed at target execution time in ConcordIO.AsyncApi.Server.targets.
    -->

    <!-- 
      Document version for the generated AsyncAPI specification.
      Falls back to $(Version), then to "1.0.0" if Version is not set.
    -->
    <ConcordIOAsyncApiDocumentVersion Condition="'$(ConcordIOAsyncApiDocumentVersion)' == ''">$(Version)</ConcordIOAsyncApiDocumentVersion>
    <ConcordIOAsyncApiDocumentVersion Condition="'$(ConcordIOAsyncApiDocumentVersion)' == ''">1.0.0</ConcordIOAsyncApiDocumentVersion>

    <!-- 
      Output format for the AsyncAPI document.
      Supported values: "json" (default, more reliable) or "yaml"
      Note: JSON is the default to avoid potential YAML serialization issues with empty objects.
    -->
    <ConcordIOAsyncApiOutputFormat Condition="'$(ConcordIOAsyncApiOutputFormat)' == ''">json</ConcordIOAsyncApiOutputFormat>

    <!-- 
      When true, the generated AsyncAPI spec is included in the NuGet package.
      The spec is placed in the asyncapi/ folder and a .targets file is generated
      to expose it as a ConcordIOAsyncApiContract item for consumers.
    -->
    <ConcordIOIncludeAsyncApiInPackage Condition="'$(ConcordIOIncludeAsyncApiInPackage)' == ''">true</ConcordIOIncludeAsyncApiInPackage>

    <!--
      TYPE DISCOVERY PATTERNS
      =======================
      Use semicolon-separated namespace patterns to discover message types.
      
      Pattern syntax:
      - "Namespace.*"   : Matches types in the exact namespace
      - "Namespace.**"  : Matches types in namespace and all sub-namespaces
      - "*TypeSuffix"   : Matches types ending with suffix (e.g., "*Event")
      - Interface/base  : Matches types implementing interface or inheriting base
      
      Examples:
      <ConcordIOEventTypes>MyApp.Events.*;MyApp.Domain.Events.**</ConcordIOEventTypes>
      <ConcordIOCommandTypes>MyApp.Commands.*</ConcordIOCommandTypes>
    -->
  </PropertyGroup>

</Project>
