<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ConcordIO.AsyncApi</RootNamespace>

    <!-- NuGet Package settings -->
    <PackageId>ConcordIO.AsyncApi</PackageId>
    <Version>0.2.0</Version>
    <Authors>LevDev</Authors>
    <Description>Core library for AsyncAPI document parsing, code generation, and contract management.</Description>
    <RepositoryUrl>https://github.com/LevDevIO/ConcordIO</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- XML Documentation for IntelliSense and Copilot assistance -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <!-- SourceLink for source navigation in debugging and IDE support -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- SourceLink for GitHub repository -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- AsyncAPI document handling -->
    <PackageReference Include="Neuroglia.AsyncApi.Core" Version="3.0.0" />

    <!-- JSON Schema generation from .NET types -->
    <PackageReference Include="NJsonSchema" Version="11.3.2" />

    <!-- C# code generation from JSON Schema -->
    <PackageReference Include="NJsonSchema.CodeGeneration.CSharp" Version="11.3.2" />

    <!-- Serialization -->
    <PackageReference Include="Neuroglia.Serialization" Version="4.20.0" />
    <PackageReference Include="Neuroglia.Serialization.YamlDotNet" Version="4.20.0" />
  </ItemGroup>

</Project>
