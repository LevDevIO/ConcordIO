<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ConcordIO.AsyncApi.Client</RootNamespace>

    <!-- XML Documentation for IntelliSense and Copilot assistance -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <!-- SourceLink for source navigation in debugging and IDE support -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- NuGet Package settings -->
    <PackageId>ConcordIO.AsyncApi.Client</PackageId>
    <Authors>LevDev</Authors>
    <Description>MSBuild integration for generating C# contract types from AsyncAPI specifications at build time. Generates proper namespaces, cross-references, and detects external types.</Description>
    <PackageTags>asyncapi;masstransit;contracts;messaging;codegen;client</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIconUrl>https://raw.githubusercontent.com/LevDevIO/ConcordIO/main/docs/assets/levdev-512-white.png</PackageIconUrl>
    <RepositoryUrl>https://github.com/LevDevIO/ConcordIO</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <Import Project="../ConcordIO.AsyncApi.Packaging.props" />

  <ItemGroup>
    <ProjectReference Include="..\ConcordIO.AsyncApi\ConcordIO.AsyncApi.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.8" PrivateAssets="all" ExcludeAssets="Runtime" />
    <!-- SourceLink for GitHub repository -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
