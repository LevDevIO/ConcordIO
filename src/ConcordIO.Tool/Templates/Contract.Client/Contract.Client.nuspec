<?xml version="1.0" encoding="utf-8"?>
<!--
  Client Package .nuspec Template
  ===============================
  This template generates the .nuspec file for client packages that wire
  contract specs to code generators (NSwag for OpenAPI, ConcordIO for AsyncAPI).
  
  MODEL KEYS:
  - client_package_id:    The client package ID (e.g., "MyService.Contracts.Client")
  - contract_package_id:  The referenced contract package ID
  - contract_version:     The contract package version to depend on
  - version:              The client package version
  - authors:              Package author(s)
  - description:          Package description
  - package_properties:   Additional metadata (license, repository, etc.)
  - has_openapi:          Boolean - true if OpenAPI specs exist
  - has_asyncapi:         Boolean - true if AsyncAPI specs exist
  
  PACKAGE CHARACTERISTICS:
  - developmentDependency: true - Only used at build time, not shipped
  - Depends on contract package to get spec files
  - Conditionally depends on code generators based on spec types
  
  DEPENDENCY STRATEGY:
  - NSwag.ApiDescription.Client: For OpenAPI → C# HTTP clients
  - ConcordIO.AsyncApi.Client:   For AsyncAPI → C# message contracts
  
  Both use exclude="compile,runtime" to prevent shipping generator assemblies.
-->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
    <metadata>
        <id>{{ client_package_id }}</id>
        <version>{{ version }}</version>
        <authors>{{ authors }}</authors>
        <description>{{ description }}</description>
        <!-- Build-time only package - not included in output assemblies -->
        <developmentDependency>true</developmentDependency>
{{~ for package_property in package_properties ~}}
        <{{ package_property.key }}>{{ package_property.value }}</{{ package_property.key }}>
{{~ end ~}}
        <dependencies>
            <!-- Contract package provides spec files -->
            <dependency id="{{ contract_package_id }}" version="{{ contract_version }}" />
{{~ if has_openapi ~}}
            <!-- NSwag generates HTTP clients from OpenAPI specs -->
            <dependency id="NSwag.ApiDescription.Client" version="14.*" include="build,contentFiles" exclude="compile,runtime"/>
{{~ end ~}}
{{~ if has_asyncapi ~}}
            <!-- ConcordIO generates message contracts from AsyncAPI specs -->
            <dependency id="ConcordIO.AsyncApi.Client" version="0.1.*" include="build" exclude="compile,runtime"/>
{{~ end ~}}
        </dependencies>
    </metadata>
    <files>
        <!-- MSBuild targets wires contracts to code generators -->
        <file src="build/{{ client_package_id }}.targets" target="build/{{ client_package_id }}.targets" />
    </files>
</package>
