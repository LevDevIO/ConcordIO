<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- XML Documentation for IntelliSense and Copilot assistance -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		
		<!-- SourceLink for source navigation in debugging and IDE support -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>

		<!-- dotnet tool settings -->
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>concordio</ToolCommandName>
		<PackageId>ConcordIO.Tool</PackageId>
		<Authors>LevDev</Authors>
		<Description>CLI tool for generating OpenAPI and Protobuf contract packages</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIconUrl>https://raw.githubusercontent.com/LevDevIO/ConcordIO/main/docs/assets/levdev-mid-nobackground.png</PackageIconUrl>
		<RepositoryUrl>https://github.com/LevDevIO/ConcordIO</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DotMake.CommandLine" Version="3.1.0" />
		<PackageReference Include="Scriban" Version="6.5.2" />
		<!-- SourceLink for GitHub repository -->
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Templates\**\*" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- oasdiff binaries for OpenAPI comparison -->
	<ItemGroup>
		<Content Include="AOComparison\oasdiff_bin\oasdiff_1.11.8_windows_amd64\oasdiff.exe">
			<Link>oasdiff\win-x64\oasdiff.exe</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackageCopyToOutput>true</PackageCopyToOutput>
		</Content>
		<Content Include="AOComparison\oasdiff_bin\oasdiff_1.11.8_windows_arm64\oasdiff.exe">
			<Link>oasdiff\win-arm64\oasdiff.exe</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackageCopyToOutput>true</PackageCopyToOutput>
		</Content>
		<Content Include="AOComparison\oasdiff_bin\oasdiff_1.11.8_linux_amd64\oasdiff">
			<Link>oasdiff\linux-x64\oasdiff</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackageCopyToOutput>true</PackageCopyToOutput>
		</Content>
		<Content Include="AOComparison\oasdiff_bin\oasdiff_1.11.8_linux_arm64\oasdiff">
			<Link>oasdiff\linux-arm64\oasdiff</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackageCopyToOutput>true</PackageCopyToOutput>
		</Content>
		<Content Include="AOComparison\oasdiff_bin\oasdiff_1.11.8_darwin_all\oasdiff">
			<Link>oasdiff\osx\oasdiff</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackageCopyToOutput>true</PackageCopyToOutput>
		</Content>
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Templates\Contract.AsyncApi.Client\" />
	</ItemGroup>

</Project>
